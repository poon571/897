.authContainer {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  position: relative;
  background: var(--color-bg-darker);
  overflow: hidden;
}

/* Background animated orbs */
.bgOrbs {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.5;
  animation: floatOrb 20s infinite alternate cubic-bezier(0.4, 0, 0.2, 1);
}
.orb1 {
  width: 400px;
  height: 400px;
  background: var(--color-primary);
  top: -10%;
  left: -10%;
}
.orb2 {
  width: 500px;
  height: 500px;
  background: var(--color-accent);
  bottom: -20%;
  right: -10%;
  animation-delay: -5s;
}
.orb3 {
  width: 300px;
  height: 300px;
  background: #2a9d8f;
  top: 40%;
  left: 40%;
  animation-delay: -10s;
}

@keyframes floatOrb {
  0% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30px, -50px) scale(1.1); }
  66% { transform: translate(-20px, 20px) scale(0.9); }
  100% { transform: translate(0, 0) scale(1); }
}

/* Glassmorphism Card */
.authCard {
  background: rgba(20, 30, 48, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 50px 40px;
  width: 100%;
  max-width: 480px;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
  position: relative;
  z-index: 1;
  animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40px); }
  to { opacity: 1; transform: translateY(0); }
}

.authHeader {
  text-align: center;
  margin-bottom: 30px;
}
.authTitle {
  font-family: var(--font-outfit);
  font-size: 2.2rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8px;
}
.authTitle span {
  background: linear-gradient(135deg, var(--color-accent-light), var(--color-primary-light));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.authSubtitle {
  color: var(--color-text-muted);
  font-size: 0.95rem;
}

/* Forms */
.formGroup {
  margin-bottom: 20px;
  position: relative;
}
.formLabel {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-text-muted);
  margin-bottom: 8px;
}
.formInputWrapper {
  position: relative;
}
.inputIcon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: #64748b;
  font-size: 1.1rem;
}
.formControl {
  width: 100%;
  padding: 14px 16px 14px 44px;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  color: #fff;
  font-family: inherit;
  font-size: 1rem;
  transition: all 0.3s;
}
.formControl:focus {
  outline: none;
  border-color: var(--color-primary-light);
  background: rgba(0, 0, 0, 0.4);
  box-shadow: 0 0 0 4px rgba(64, 145, 108, 0.15);
}
.formControl::placeholder {
  color: #64748b;
}

/* Password Toggle */
.btnTogglePwd {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #64748b;
  cursor: pointer;
  font-size: 1.1rem;
  padding: 0;
  transition: color 0.3s;
}
.btnTogglePwd:hover {
  color: #fff;
}

/* Password Strength Meter */
.pwdStrength {
  margin-top: 10px;
}
.strengthBars {
  display: flex;
  gap: 6px;
  margin-bottom: 6px;
}
.strengthBar {
  height: 4px;
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
  transition: background 0.3s;
}
.strengthText {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  text-align: right;
  display: block;
}

/* Buttons */
.btnSubmit {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  border: none;
  border-radius: 12px;
  font-family: inherit;
  font-size: 1.05rem;
  font-weight: 700;
  cursor: pointer;
  margin-top: 10px;
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
}
.btnSubmit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(45, 106, 79, 0.4);
}
.btnSubmit:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}
.spinner {
  width: 20px;
  height: 20px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: #fff;
  animation: spin 1s ease-in-out infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

.authFooter {
  text-align: center;
  margin-top: 24px;
  font-size: 0.9rem;
  color: var(--color-text-muted);
}
.authLink {
  color: var(--color-accent-light);
  text-decoration: none;
  font-weight: 600;
  transition: color 0.3s;
}
.authLink:hover {
  color: var(--color-accent);
  text-decoration: underline;
}

/* Alert Message */
.alert {
  padding: 12px 16px;
  border-radius: 8px;
  margin-bottom: 20px;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 10px;
  animation: fadeInDown 0.3s ease-out;
}
.alert.error {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid rgba(239, 68, 68, 0.3);
  color: #fca5a5;
}
.alert.success {
  background: rgba(34, 197, 94, 0.15);
  border: 1px solid rgba(34, 197, 94, 0.3);
  color: #86efac;
}

@media (max-width: 480px) {
  .authCard {
      padding: 40px 24px;
  }
}
